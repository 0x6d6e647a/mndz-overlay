BDEPEND=media-fonts/craft-fonts:= || ( >=dev-lang/rust-bin-1.95.0:* >=dev-lang/rust-1.95.0:* )
DEFINED_PHASES=compile configure install postinst postrm preinst setup test unpack
DESCRIPTION=Open-source native word processor
EAPI=8
