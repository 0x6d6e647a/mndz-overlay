BDEPEND=dev-build/cmake dev-lang/nasm media-fonts/craft-fonts:= || ( >=dev-lang/rust-bin-1.95.0:* >=dev-lang/rust-1.95.0:* )
DEFINED_PHASES=compile configure install postinst postrm preinst prepare setup test unpack
DESCRIPTION=Open-source native PDF tool
EAPI=8
HOMEPAGE=https://getartcraft.com/apps/pdfcraft https://github.com/storytold/pdfcraft
IDEPEND=dev-util/desktop-file-utils x11-misc/shared-mime-info
INHERIT=cargo mndz-cargo desktop xdg
IUSE=+gui +cli +portal +X +wayland test cups debug
KEYWORDS=-* ~amd64 ~arm ~arm64 ~loong ~ppc64 ~riscv ~s390 ~sparc ~x86
LICENSE=|| ( MIT Apache-2.0 ) Apache-2.0 BSD-2 BSD Boost-1.0 CDLA-Permissive-2.0 ISC MIT Unicode-3.0 ZLIB OFL-1.1 ISC CC0-1.0 BSD
RDEPEND=cups? ( net-print/cups ) gui? ( sys-apps/dbus x11-misc/xdg-utils media-libs/libglvnd media-libs/vulkan-loader x11-libs/libxkbcommon portal? ( sys-apps/xdg-desktop-portal ) !portal? ( gnome-extra/zenity ) ) X? ( x11-libs/libX11 x11-libs/libXcursor x11-libs/libXi x11-libs/libXrandr x11-libs/libxkbcommon[X] ) wayland? ( dev-libs/wayland )
REQUIRED_USE=|| ( gui cli ) gui? ( || ( X wayland ) )
RESTRICT=!test? ( test )
SLOT=0
