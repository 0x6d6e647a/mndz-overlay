(require :asdf)

(defparameter *share* (uiop:ensure-directory-pathname (second sb-ext:*posix-argv*)))
(defparameter *cores* (uiop:ensure-directory-pathname (third sb-ext:*posix-argv*)))

(defun fail (format-control &rest arguments)
  (apply #'format *error-output* format-control arguments)
  (terpri *error-output*)
  (sb-ext:exit :code 1))

(defun read-manifest (name)
  (let ((path (merge-pathnames name *cores*))
        (*read-eval* nil)
        (eof (gensym)))
    (handler-case
        (with-open-file (stream path)
          (let ((form (read stream nil eof)))
            (unless (and (consp form) (eq (read stream nil eof) eof))
              (fail "Expected exactly one manifest form in ~A" path))
            form))
      (error (condition) (fail "Cannot read manifest ~A: ~A" path condition)))))

(defun manifest-fields (form tag version)
  (unless (and (consp form) (eq (car form) tag)
               (eql (getf (cdr form) :version) version))
    (fail "Unsupported manifest format, expected ~S version ~D" tag version))
  (cdr form))

(defun blob-id-p (value)
  (and (stringp value) (member (length value) '(40 64))
       (every (lambda (character) (digit-char-p character 16)) value)))

(defun runtime-file (name context)
  (unless (and (stringp name)
               (notany (lambda (character) (find character name)) '(#\\ #\: #\* #\?))
               (every (lambda (part) (not (member part '("" "." "..") :test #'string=)))
                      (uiop:split-string name :separator "/")))
    (fail "Invalid ~A path: ~S" context name))
  (let* ((path (merge-pathnames name *share*))
         (actual (ignore-errors (truename path))))
    (unless (and actual (uiop:subpathp actual *share*)
                 (zerop (nth-value 2
                                   (uiop:run-program
                                    (list "test" "-f" (namestring actual) "-a" "-r" (namestring actual))
                                    :ignore-error-status t))))
      (fail "Missing or unreadable ~A: ~A" context name))
    actual))

(defun check-provenance (fields kind commit)
  (unless (equal (getf fields :source-commit) commit)
    (fail "~A manifest provenance differs from packaged HEAD ~A" kind commit))
  (unless (eq t (getf fields :source-clean-p))
    (fail "~A manifest records dirty source" kind)))

(defparameter *recovery-inputs*
  '((:runtime-blob "recovery/runtime.lisp")
    (:trace-context-source-blob "script/trace-context.lisp")
    (:builder-blob "script/build-recovery")
    (:builder-source-blob "script/build-recovery.lisp")
    (:runtime-requirement-blob "script/runtime-requirement.lisp")
    (:windows-stat-blob "script/windows-stat.lisp")
    (:source-launcher-blob "recovery/launcher.lisp")
    (:stable-launcher-blob "bin/autolith")
    (:active-source-launcher-blob "bin/autolith-active")
    (:runtime-adapter-blob "bin/autolith-runtime")
    (:check-blob "script/check")
    (:check-source-blob "script/check.lisp")
    (:dependency-lock-blob "qlfile.lock")
    (:sbcl-version-blob "sbcl.version")))

(defun check-recovery-input (fields key path)
  (unless (blob-id-p (getf fields key))
    (fail "Invalid recovery manifest blob: ~S" key))
  (runtime-file path "recovery manifest input"))

(handler-case
    (let* ((outer (manifest-fields (read-manifest "active/manifest.sexp")
                                   :sbcl-generations-image-manifest 1))
           (active (manifest-fields (getf outer :record) :sbcl-generations-image 1))
           (recovery (manifest-fields (read-manifest "recovery/manifest.sexp") :recovery-image 2))
           (commit (fourth sb-ext:*posix-argv*))
           (inputs (getf active :source-files)))
      (check-provenance active "Active" commit)
      (check-provenance recovery "Recovery" commit)
      (unless (consp inputs) (fail "Active manifest has no source inputs"))
      (dolist (entry inputs)
        (unless (and (consp entry) (consp (cdr entry)) (null (cddr entry))
                     (blob-id-p (second entry)))
          (fail "Malformed active manifest input: ~S" entry))
        (runtime-file (first entry) "active manifest input"))
      (dolist (entry *recovery-inputs*)
        (destructuring-bind (key path) entry
          (check-recovery-input recovery key path)))
      (when (or (getf recovery :sbcl-minimum-version-blob)
                (probe-file (merge-pathnames "sbcl-minimum.version" *share*)))
        (check-recovery-input recovery :sbcl-minimum-version-blob "sbcl-minimum.version"))
      (runtime-file "docs/onboarding-sources.org" "onboarding resource")
      (format t "Validated Autolith manifests and runtime inputs at ~A~%" commit))
  (error (condition) (fail "Autolith staged runtime validation failed: ~A" condition)))
